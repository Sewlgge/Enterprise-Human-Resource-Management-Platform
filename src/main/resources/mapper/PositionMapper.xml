<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.management.mapper.PositionMapper">

    <!--动态sql-->

    <select id="list" resultType="com.company.management.entity.Position">
        select * from position
        <where>
            <if test="dto.name != null and dto.name != ''">
                name like concat('%',#{dto.name},'%')
            </if>
            <if test="dto.deptId != null">
                and dept_id = #{dto.deptId}
            </if>
            and is_deleted = 0
        </where>
    </select>

    <insert id="add">
        insert into position (name,description,dept_id) values (#{dto.name},#{dto.description},#{dto.deptId})
    </insert>

</mapper>
